# Copy to BackEnd/.env for local development. Every value here is empty on
# purpose; the real ones live only in the Render dashboard. See README.md
# ("Environment variables") and SECURITY_PLAN.md.

# Required. postgresql://user:pass@host:5432/db (TLS is enforced in production).
DATABASE_URL=

# development (default off Render) | production (default on Render).
APP_ENV=development

# Phase 0 shared-key gate: off | shadow | enforce, and the key itself (32+ chars).
APP_KEY_MODE=off
APP_KEY=

# MCP connector path secret (32+ random chars). Required in production.
MCP_PATH_SECRET=
# Comma-separated tool names the connector may use; * = all.
MCP_SCOPES=*

# Gmail app password for /send-offer (unset -> the feature reports "not configured").
EMAIL_PASSWORD=
SEND_OFFER_PER_HOUR=30

# Mercury: one read-only, IP-allow-listed token per workspace; the suffix is the label.
MERCURY_API_TOKEN_EXAMPLE=
MERCURY_CACHE_SECONDS=60

# REPS tracker (Google Sheets + GCS). See REPS_README.md.
GOOGLE_APPLICATION_CREDENTIALS=
REPS_SHEET_ID_AVIV=
REPS_SHEET_ID_YARDEN=
REPS_SHEET_TAB=Log
REPS_GCS_BUCKET=
REPS_GCS_BASE_PREFIX=evidence/2026
REPS_LINK_STYLE=public
REPS_OBJECT_ACL_PUBLIC=true

# Request-body ceiling in bytes (default 30 MB).
MAX_BODY_BYTES=
