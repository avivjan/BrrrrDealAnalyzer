{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:record": "PW_RECORD=1 playwright test --project=chromium",
    "e2e:report": "playwright show-report",
    "e2e:compare": "node e2e/scripts/compare-reports.mjs e2e/reports/phase0-baseline.json e2e/reports/phase5-final.json",
    "test:watch": "vitest",
    "audit:baseline": "node scripts/audit/script-blocks.mjs --write && node scripts/audit/bindings.mjs --write && node scripts/audit/text.mjs --write",
    "audit": "node scripts/audit/script-blocks.mjs && node scripts/audit/bindings.mjs && node scripts/audit/text.mjs",
    "audit:contrast": "node scripts/audit/contrast.mjs",
    "verify:ui": "node scripts/audit/verify-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@primevue/themes": "^4.5.1",
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.1",
    "tailwind-merge": "^3.4.0",
    "vue": "^3.5.24",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.25",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.22",
    "diff": "^9.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.1.4"
  },
  "browserslist": [
    "defaults",
    "iOS >= 15",
    "Safari >= 15",
    "Chrome >= 100"
  ]
}
